# Copy to .env and fill in. docker compose picks these up automatically.

# Google Gemini key used by the Land, Agri and Community services.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# data.gov.in key used by the Agri (mandi prices) and Water services.
DATAGOV_API_KEY=

# Address the BROWSER uses to reach the API gateway.
VITE_API_URL=http://localhost:5130
